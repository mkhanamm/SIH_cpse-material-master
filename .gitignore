__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Runtime artifacts: keep the folder, not the generated data
outputs/*
!outputs/.gitkeep

# models/classifier.pkl is committed deliberately: the unlabelled pipeline
# path (app.run_pipeline via classifier.load_model_or_none) depends on it at
# runtime so a fresh clone works on an uploaded dataset without retraining.
# Regenerate it with `python -m src.classifier`. Any other .pkl stays ignored.
models/*.pkl
!models/.gitkeep
!models/classifier.pkl

# Cached embeddings
*.npy
